<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{item.code}}</title>
<style>
  /* System fonts only: the page may load nothing from the network. The Docker image installs Noto Sans Bengali. */
  body { font-family: 'Noto Sans', 'Noto Sans Bengali', sans-serif; color: #1f2937; font-size: 12px; }
  h1 { font-size: 18px; margin: 0 0 4px; }
  .muted { color: #6b7280; }
  table { width: 100%; border-collapse: collapse; margin-top: 16px; }
  th, td { border: 1px solid #d1d5db; padding: 6px 8px; text-align: left; vertical-align: top; }
  th { background: #f3f4f6; width: 32%; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 9px; background: #dcfce7; color: #166534; }
  .badge.Inactive { background: #fee2e2; color: #991b1b; }
</style>
</head>
<body>
  <h1>{{item.name_en}} <span class="muted">({{item.code}})</span></h1>
  <table>
    <tr><th>Category</th><td>{{item.category_en}}</td></tr>
    <tr><th>Contact mobile</th><td>{{item.contact_mobile}}</td></tr>
    <tr><th>Effective date</th><td>{{item.effective_date}}</td></tr>
    <tr><th>Amount</th><td>{{taka item.amount}}</td></tr>
    <tr><th>Status</th><td><span class="badge {{item.status}}">{{item.status}}</span></td></tr>
  </table>
  {{#if item.lines.length}}
  <table>
    <tr><th>#</th><th>Label</th><th>Value</th></tr>
    {{#each item.lines}}<tr><td>{{inc @index}}</td><td>{{this.label}}</td><td>{{this.value}}</td></tr>{{/each}}
  </table>
  {{/if}}
  <p class="muted">Generated {{generatedAt}}</p>
</body>
</html>
