# `npm run dev`: everything in-process. PGlite (real PostgreSQL in WebAssembly) keeps the data in
# storage/pglite, so it survives restarts; delete the folder to start over.
# Not secret, not for any server. Personal overrides go in .env.local (git-ignored).
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
DB_DRIVER=pglite
PGLITE_DATA_DIR=storage/pglite
# Create and fill it first, with the API stopped (PGlite allows one process at a time):
#   cd ../fitmanager-infra/db && PGLITE_DIR=../../fitmanager-api/storage/pglite npm run seed
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Guest access: the /demo picker of a proxy build signs in as these without a password.
GUEST_ACCOUNTS=owner,admin.hq,manager.gulshan,desk.gulshan,trainer.gulshan,MEM-GUL-000001
