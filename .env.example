# Every variable the API reads (validated in src/config/env.ts). Locally they come from .env.development and
# .env.local; on Cloudflare from wrangler.jsonc vars and `wrangler secret put` (JWT_SECRET, S3_* keys).
NODE_ENV=production
APP_ENV=demo
APP_VERSION=
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api
CORS_ORIGINS=
TRUST_PROXY=1
LOG_LEVEL=info
LOG_PRETTY=false

DB_DRIVER=pg
DATABASE_URL=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# The schema and demo data are not this app's job (D-039): run `npm run migrate` and `npm run seed` in
# fitmanager-infra/db first.

JWT_SECRET=
JWT_ISSUER=fitmanager-api
JWT_AUDIENCE=fitmanager-web
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
REFRESH_REUSE_GRACE=30
LOGIN_RATE_LIMIT=10
# scrypt cost for new password hashes. Cheap default for the Workers Free plan (10 ms CPU, D-032).
PASSWORD_SCRYPT_N=1024
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
# Guest access (D-076): seeded accounts anyone may sign in as without a password (the demo's /demo picker).
# Nobody can change these accounts. Empty: off.
GUEST_ACCOUNTS=

# Files (D-058): local disk for development; s3 for Cloudflare R2. The keys are yours to set, never committed.
FILE_STORE=local
FILE_DIR=storage/files
# FILE_STORE=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=fitmanager-files
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# The most all files may take together; R2's free plan has 10 GB (D-074, D-075).
FILE_STORAGE_LIMIT_MB=8192
