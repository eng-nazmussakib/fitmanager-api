# Every variable the API reads (validated in src/config/env.ts). Secrets: set NAME_FILE=/run/secrets/... instead
# of NAME (works for DATABASE_URL, JWT_SECRET, REDIS_URL, SMTP_URL, RECAPTCHA_SECRET, OTP_SECRET).
NODE_ENV=production
APP_ENV=dev
APP_VERSION=
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api
CORS_ORIGINS=
TRUST_PROXY=1
LOG_LEVEL=info
LOG_PRETTY=false

DB_DRIVER=pg
DATABASE_URL_FILE=/run/secrets/skeleton_database_url
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# The schema and demo data are not this app's job (D-039): run `npm run migrate` in fitmanager-infra/db first.

JWT_SECRET_FILE=/run/secrets/skeleton_jwt_secret
JWT_ISSUER=skeleton-api
JWT_AUDIENCE=skeleton-web
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
REFRESH_REUSE_GRACE=30
LOGIN_RATE_LIMIT=10
# scrypt cost for new password hashes. Cheap default for the Workers Free plan (10 ms CPU); raise it on a
# server, e.g. N=131072 r=8 p=1. Existing hashes are upgraded at the next sign-in.
PASSWORD_SCRYPT_N=1024
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=1
# External identity provider (all three or none):
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

REDIS_URL=
SMTP_URL=
MAIL_FROM=Skeleton <no-reply@example.com>
OTP_SECRET=
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
CHROME_PATH=/usr/bin/chromium
SCHEDULER_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
